# ==========================================
# Debate Coach Application Configuration
# ==========================================

# Database selection (Target postgresql or local sqlite)
DATABASE_URL=sqlite:///debate.db

# JWT Security Signature key
SECRET_KEY=infosysspringboard

# AI Provider choice: mock, openai
LLM_PROVIDER=mock

# OpenAI credentials (Only required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq credentials (Only required if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

