# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=debate-coach-secret-key-2024-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Local default is SQLite. Use PostgreSQL for production-style deployment.
DATABASE_URL=sqlite:///./debate_coach.db
# DATABASE_URL=postgresql+psycopg2://debate:debate_password@postgres:5432/debate_coach
MONGODB_URL=
MONGODB_DATABASE=debate_coach

# ── LLM Providers (set one to enable real AI) ─────────────────────────────────
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ── Redis (optional — falls back to in-memory) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Kafka (optional — set KAFKA_ENABLED=true to activate) ────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Vector Store ──────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./faiss_index
# PINECONE_API_KEY=
# PINECONE_INDEX=debate-coach

# ── External Services (optional) ─────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@debatecoach.ai
AWS_S3_BUCKET=debate-coach-media
AWS_REGION=us-east-1

# OAuth2 login providers
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Speech transcription. The upload endpoint accepts media today and analyzes
# supplied transcripts. Set true after wiring Whisper or another provider.
WHISPER_ENABLED=false
